# Copy to .env locally or on the deployment host. Never commit real values.
# Production deploys require an exact lowercase 40-character commit SHA.
FMR_IMAGE_TAG=
FMR_ENVIRONMENT=production
# Standard requires S3+SMTP. The bonifacio.work Compose temporarily overrides this with
# single_user_local, local persistent storage, and disabled public email account workflows.
FMR_DEPLOYMENT_PROFILE=standard
FMR_SSO_ENABLED=false
FMR_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@cksDB:5432/feelmyrythm
FMR_AUTO_CREATE_SCHEMA=false
# Required in production. Generate a unique value, for example with: openssl rand -base64 48
FMR_JWT_SECRET=
FMR_WEB_APP_BASE_URL=https://bonifacio.work/feelmyrythm
# Required in production for registration verification email.
FMR_SMTP_HOST=
FMR_SMTP_PORT=587
FMR_SMTP_FROM_EMAIL=
# Enable exactly one transport security mode. STARTTLS on port 587 is the default.
FMR_SMTP_STARTTLS=true
FMR_SMTP_USE_SSL=false
# Optional SMTP authentication. Configure both values together or leave both blank.
FMR_SMTP_USERNAME=
FMR_SMTP_PASSWORD=
# Bounded authentication workers. Tune only after measuring CPU and provider capacity.
FMR_MAIL_WORKER_COUNT=2
FMR_MAIL_QUEUE_CAPACITY=128
FMR_MAIL_SHUTDOWN_TIMEOUT_SECONDS=5
FMR_PASSWORD_VERIFY_CONCURRENCY=4
# Web plus the fixed Capacitor iOS/Android origins from apps/mobile/capacitor.config.ts.
FMR_CORS_ORIGINS='["https://bonifacio.work","capacitor://app.feelmyrythm.local","https://app.feelmyrythm.local"]'
FMR_PUBLIC_API_BASE_URL=https://bonifacio.work/feelmyrythm
# The portfolio RPi Compose fixes this private, unexposed service URL.
# Deployments outside that Compose contract may use a dedicated authenticated/TLS endpoint.
FMR_REDIS_URL=redis://fmrRedis:6379/0
FMR_REDIS_KEY_PREFIX=fmr
FMR_ROOM_PRESENCE_TTL_SECONDS=45
FMR_ROOM_LOCK_SECONDS=5
FMR_ROOM_LOCK_WAIT_SECONDS=2
# Standard production is S3-only. single_user_local is the explicit temporary exception.
FMR_STORAGE_BACKEND=s3
FMR_S3_BUCKET=
FMR_S3_REGION=ap-northeast-2
# Optional for AWS S3; set this for an S3-compatible provider.
FMR_S3_ENDPOINT_URL=
# Durable storage lifecycle worker and upload-staging safety windows.
# The worker is mandatory in production; false is useful only for isolated tests.
FMR_STORAGE_WORKER_ENABLED=true
FMR_STORAGE_WORKER_INTERVAL_SECONDS=30
FMR_STORAGE_DELETE_BATCH_SIZE=100
FMR_STORAGE_DELETE_LEASE_SECONDS=300
FMR_STORAGE_DELETE_RETRY_BASE_SECONDS=5
FMR_STORAGE_DELETE_RETRY_MAX_SECONDS=3600
FMR_PENDING_UPLOAD_GRACE_SECONDS=900
FMR_LEGACY_PENDING_UPLOAD_TTL_SECONDS=86400
FMR_LATE_UPLOAD_GUARD_SECONDS=86400
FMR_STAGING_REDELETE_INTERVAL_SECONDS=900
FMR_LOCAL_UPLOAD_TEMP_TTL_SECONDS=3600
# Audiveris is an external AGPL application. Enable this only when the executable is installed
# (or a compatible command wrapper is mounted) on the server architecture.
FMR_OMR_ENABLED=false
FMR_OMR_AUDIVERIS_COMMAND=audiveris
FMR_OMR_WORKER_COUNT=1
FMR_OMR_TIMEOUT_SECONDS=300
FMR_GOOGLE_CLIENT_ID=

# Optional web client ID for the Google Identity Services button.
# Use the same OAuth 2.0 web client ID as FMR_GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Public mobile signing identities used to generate/verify .well-known association files.
# Keep private keys and passwords out of this file. The Android SHA-256 fingerprint is public.
FMR_IOS_DEVELOPMENT_TEAM=
FMR_ANDROID_CERT_SHA256=

# boto3 reads S3 credentials from the standard AWS variables.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=  # Uncomment only for temporary credentials.
